# TypeWords 静态部署镜像
#
# 产物由本地/CI 用 `pnpm generate` 生成，本镜像只负责打包与托管：
# 没有任何 RUN 步骤 → 构建期不需要目标架构模拟，
# 因此可以直接在 Apple Silicon 上产出 linux/amd64 镜像（甚至多架构）。
#
# 构建前置：先执行 pnpm generate，确保 .output/public 存在。
# 推荐用 scripts/build-static.sh 一键完成。

# 基础镜像可通过 --build-arg NGINX_IMAGE=... 覆盖
# （国内网络拉不动 Docker Hub 时用 docker.m.daocloud.io/library/nginx:alpine）
ARG NGINX_IMAGE=nginx:alpine

FROM ${NGINX_IMAGE}

# 容器内 nginx：SPA 兜底（200.html）+ 静态资源缓存策略
COPY deploy/nginx-static.conf /etc/nginx/conf.d/default.conf

# 静态产物（约 17MB：_nuxt/ libs/ dicts/ imgs/ sound/ 等）
COPY .output/public /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
